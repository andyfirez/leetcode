   "source": [
    "def binarySearch(arr, targetVal):\n",
    "  left = 0\n",
    "  right = len(arr) - 1\n",
    "\n",
    "  while left <= right:\n",
    "    mid = (left + right) // 2\n",
    "\n",
    "    if arr[mid] == targetVal:\n",
    "      return mid\n",
    "\n",
    "    if arr[mid] < targetVal:\n",
    "      left = mid + 1\n",
    "    else:\n",
    "      right = mid - 1\n",
    "\n",
    "  return -1"
   ]
  }
 ],
